# Groq only. Local development automatically uses the hosted Rotom API.
# No Ollama process or local key is required when hosting has a valid Groq secret.
# To run Groq directly on your own backend, put the key in .env.local:
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Public URLs only, never API keys:
ROTOM_HOSTED_API_URL=https://aryan-parab-pokedex.kindbow12.chatgpt.site/api/profile
